# Copy to .env.local (gitignored) and fill in from Supabase → Project Settings → API Keys.
# Both values are PUBLIC by design and end up in the browser bundle; Row Level Security
# protects the data. NEVER put a secret / service_role key in any VITE_ variable.
# Leave both empty to run with device-only demo accounts (no cloud saving).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
